<Application x:Class="VoiceInputBuddy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VoiceInputBuddy.App.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <!-- Value Converters -->
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BoolToScanTextConverter x:Key="BoolToScanTextConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:EqualValueToVisibilityConverter x:Key="EqualValueToVisibilityConverter"/>
        <converters:EqualValueToBoolConverter x:Key="EqualValueToBoolConverter"/>
        <converters:EqualValueToBrushConverter x:Key="EqualValueToBrushConverter"/>
        <converters:GainToDbTextConverter x:Key="GainToDbTextConverter"/>
        <converters:BatteryVisibilityConverter x:Key="BatteryVisibilityConverter"/>
        <converters:EnumToDisplayNameConverter x:Key="EnumToDisplayNameConverter"/>

        <!-- Fluent Dark/Light Theme Colors -->
        <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentColorBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColorBrush" Color="#3E3E42"/>

        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="BorderBrush" Value="#0098FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
