<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VoiceInputBuddy.App.Converters">
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设备连接" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="管理已配对或已发现的蓝牙遥控器。选择设备并连接：" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding IsScanning, Converter={StaticResource BoolToScanTextConverter}, FallbackValue='🔍 扫描设备'}"
                        Margin="0,0,10,0" Padding="14,8"
                        Command="{Binding ToggleScanCommand}"/>
                <Button Content="➕ 添加新设备" Padding="14,8" Background="#007ACC"
                        Command="{Binding AddDeviceCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Current Active Device Banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                    <TextBlock Text="当前状态：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding ConnectedDeviceName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" Margin="4,0,14,0"/>
                    <TextBlock Text="·  " Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                    <TextBlock Text="🎙️ " FontSize="13"/>
                    <TextBlock Text="{Binding VoiceIntegrationSummary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Device Cards List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="20" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Device Identity & Action Buttons -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <!-- Device Header Box -->
                                    <Border Background="#252A30" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, FallbackValue='未知遥控器'}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ModelType, StringFormat='型号: {0}'}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding BatteryLevel, StringFormat=' · 🔋 {0}%'}" FontSize="12" Foreground="#00CC66" Margin="4,0,0,0"
                                                           Visibility="{Binding BatteryLevel, Converter={StaticResource BatteryVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Visual Remote Silhouette Icon -->
                                    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3A3A3C" BorderThickness="1" Width="72" Height="130" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top indicator / Mic hole -->
                                            <Ellipse Width="6" Height="6" Fill="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- Circular D-pad preview -->
                                            <Ellipse Grid.Row="1" Width="36" Height="36" Stroke="#444" StrokeThickness="1" Fill="#282828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse Grid.Row="1" Width="14" Height="14" Fill="#383838" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- Bottom volume buttons -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="16" Height="8" Background="#333" CornerRadius="2" Margin="2,0"/>
                                                <Border Width="16" Height="8" Background="#333" CornerRadius="2" Margin="2,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Connect / Reconnect Button -->
                                    <Button Content="连接设备" Margin="0,0,0,8" Padding="12,7" Background="#007ACC"
                                            Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Remove Device Button -->
                                    <Button Content="🗑️ 删除设备" Padding="12,6" Background="Transparent" BorderBrush="#663333" Foreground="#FF6666"
                                            Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Background="{StaticResource BorderColorBrush}"/>

                                <!-- Right Column: Audio Gain & Device Details -->
                                <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                    <!-- Microphone Gain -->
                                    <TextBlock Text="麦克风输入增益 (Gain)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="1.0" Maximum="15.8" Value="{Binding Gain, Mode=TwoWay}"
                                                TickFrequency="1.0" IsSnapToTickEnabled="False" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Gain, Converter={StaticResource GainToDbTextConverter}}"
                                                   FontFamily="Consolas" FontSize="13" Foreground="#00CC66"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="根据说话音量调节输入增益；默认推荐 0 dB ~ 12 dB。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                                    <!-- Technical Device Info Grid -->
                                    <TextBlock Text="设备详细信息" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- MAC / ID -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12">
                                            <TextBlock Text="设备标识 (ID / MAC)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding Id, FallbackValue='未知'}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Container ID -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                            <TextBlock Text="Windows 容器标识 (Container ID)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding ContainerId, TargetNullValue='自动匹配中...'}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Audio Spec -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="音频传输规格" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="16kHz 16-bit Mono (IMA-ADPCM)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Voice Protocol -->
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="语音通信协议" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="Android TV Voice (ATVV GATT)" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
