<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.EnvironmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="环境与驱动" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="系统虚拟音频驱动与底层蓝牙环境状态检查" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 刷新状态" VerticalAlignment="Center" Padding="14,8" Background="#007ACC"
                        Command="{Binding RefreshStatusCommand}"/>
            </Grid>

            <!-- Card 1: VB-CABLE Virtual Microphone -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock Text="VB-CABLE 虚拟麦克风音频驱动" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" DockPanel.Dock="Left"/>
                        <Border Background="#1C3827" BorderBrush="#2D6A42" BorderThickness="1" CornerRadius="10" Padding="10,3" DockPanel.Dock="Right">
                            <TextBlock Text="{Binding DriverStatus}" Foreground="#44FF88" FontSize="12" FontWeight="Medium"/>
                        </Border>
                    </DockPanel>

                    <TextBlock Text="{Binding StatusDescription}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="驱动安装与配置指南：" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="1. VB-CABLE 为获微软官方 WHQL 认证签名的虚拟音频驱动；&#x0a;2. 若尚未安装，请访问 VB-Audio 官网 (vb-audio.com/Cable/) 下载 Driver Pack；&#x0a;3. 解压后右键管理员身份运行 VBCABLE_Setup_x64.exe 进行安装；&#x0a;4. 安装完成后若提示需要重启，请重启电脑完成系统音频服务初始化。"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Windows System Services -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="系统服务与输入链路" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                    <!-- Grid of Subsystems -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Subsystem 1 -->
                        <Border Grid.Column="0" Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="📶 WinRT BLE" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="Windows.Devices.Bluetooth" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,8"/>
                                <TextBlock Text="🟢 正常运行" FontSize="12" Foreground="#00CC66"/>
                            </StackPanel>
                        </Border>

                        <!-- Subsystem 2 -->
                        <Border Grid.Column="1" Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="⌨️ RawInput" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="WM_INPUT 硬件监听" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,8"/>
                                <TextBlock Text="🟢 正常运行" FontSize="12" Foreground="#00CC66"/>
                            </StackPanel>
                        </Border>

                        <!-- Subsystem 3 -->
                        <Border Grid.Column="2" Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🛡️ KeyGuard" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="LowLevel Keyboard Hook" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3,0,8"/>
                                <TextBlock Text="🟢 正常运行" FontSize="12" Foreground="#00CC66"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
