<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.IntegrationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VoiceInputBuddy.App.Converters">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Page Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="输入法集成" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="配合微信键盘、豆包或系统语音输入使用。遥控器说话时，会自动唤起所选工具并传输麦克风音频。"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Current Configuration Card -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="当前配置与链路状态" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding CurrentToolDisplayName}" FontSize="20" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shortcut & Trigger Mode -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="⌨️ 唤起快捷键：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                                <Border Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding CurrentShortcutDisplay}" Foreground="#FFF" FontFamily="Consolas" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙️ 触发方式：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding CurrentTriggerModeDisplay}" Foreground="#FFF" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Virtual Microphone Device Route -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔊 麦克风路由：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding VirtualCableStatusDescription}" Foreground="#00CC66" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="目标输入法中需将录音麦克风选为该虚拟设备" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#25282E" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="💡 提示: 请在微信键盘或豆包的【设置 → 语音设置 → 麦克风】中指定为【CABLE Input (VB-Audio Virtual Cable)】，即可畅享遥控器一键高质转写。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Presets Section Header -->
            <TextBlock Text="主流输入法预设" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

            <!-- Presets Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preset 1: WeChat Input -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="微信输入法" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#1B4D2B" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="推荐 · Ctrl+Win" FontSize="11" Foreground="#44FF88"/>
                            </Border>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="选择并应用" Padding="14,7" Background="#007ACC" HorizontalAlignment="Left"
                                Command="{Binding ApplyPresetCommand}" CommandParameter="WeChatInput"/>
                        <TextBlock Text="原生支持长按快捷键说话，松开后自动识别并上屏。推荐设置触发模式为【按住说话】。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Preset 2: Doubao -->
                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="豆包输入法 / 客户端" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#2B3E52" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="F1 · 悬浮麦克风" FontSize="11" Foreground="#66B3FF"/>
                            </Border>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="选择并应用" Padding="14,7" Background="#007ACC" HorizontalAlignment="Left"
                                Command="{Binding ApplyPresetCommand}" CommandParameter="DoubaoInput"/>
                        <TextBlock Text="支持豆包悬浮麦克风实时 AI 语音识别与文本优化。按住 F1 即可随心说话。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Preset 3: Windows Dictation -->
                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Windows 语音听写" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#3D3A20" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Win+H · 单击切换" FontSize="11" Foreground="#FFD700"/>
                            </Border>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="选择并应用" Padding="14,7" Background="#007ACC" HorizontalAlignment="Left"
                                Command="{Binding ApplyPresetCommand}" CommandParameter="WindowsDictation"/>
                        <TextBlock Text="Windows 10/11 内置原生听写，按一下开始录音，再按一下完成。无需安装任何第三方工具。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Preset 4: Typeless -->
                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Typeless 智能转写" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#3C2A4A" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="Ctrl+Alt+V" FontSize="11" Foreground="#DDA0DD"/>
                            </Border>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="选择并应用" Padding="14,7" Background="#007ACC" HorizontalAlignment="Left"
                                Command="{Binding ApplyPresetCommand}" CommandParameter="Typeless"/>
                        <TextBlock Text="支持 Typeless 全局听写客户端，长按 Ctrl+Alt+V 录音，松开即刻转写为精准文字。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Custom Tuning & Behavior Form -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="语音触发行为微调" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <!-- Trigger Mode -->
                    <TextBlock Text="触发行为方式：" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,16">
                        <RadioButton Content="按住说话 (Hold to Talk) — 按住遥控器语音键说话，松开自动转写（推荐微信/豆包）"
                                     IsChecked="{Binding IsHoldToTalk}" Foreground="#FFF" Margin="0,0,0,8"/>
                        <RadioButton Content="单击切换 (Click to Toggle) — 按一下开始收音，再按一下结束收音（推荐 Win+H）"
                                     IsChecked="{Binding IsClickToToggle}" Foreground="#FFF"/>
                    </StackPanel>

                    <!-- Shortcut Input -->
                    <TextBlock Text="全局触发快捷键：" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ShortcutText, UpdateSourceTrigger=PropertyChanged}"
                             Width="320" HorizontalAlignment="Left" Background="#1E1E1E" Foreground="#FFF" Padding="10,7" Margin="0,0,0,6"/>
                    <TextBlock Text="支持组合键输入，如 'Ctrl+Win'、'F1'、'Win+H'、'Ctrl+Alt+V'、'F5' 等。"
                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="💾 保存当前设置" Padding="20,9" Background="#007ACC" Command="{Binding SaveCommand}"/>
                        <TextBlock Text="✅ 设置已保存" Foreground="#00CC66" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Visibility="{Binding SaveNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
