<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:VoiceInputBuddy.Core.Models;assembly=VoiceInputBuddy.Core"
             xmlns:vm="clr-namespace:VoiceInputBuddy.App.ViewModels">
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="按键映射" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding DeviceNote}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="正在编辑：" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="170" Margin="0,0,14,0"/>
                <CheckBox Content="启用自定义按键" IsChecked="{Binding CustomMappingEnabled}" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Footer: RawInput Status & Selection Lock & Reset Defaults -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⌨️ " FontSize="13"/>
                    <TextBlock Text="硬件按键接收: RawInput 监听中" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,18,0"/>
                    <CheckBox Content="锁定当前按键 (按实体遥控器时不自动切换选择)" IsChecked="{Binding IsMappingSelectionLocked}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="🔄 恢复默认映射" DockPanel.Dock="Right" Padding="12,6" Background="Transparent" BorderBrush="{StaticResource BorderColorBrush}" Foreground="{StaticResource SecondaryTextBrush}"
                        Command="{Binding ResetToDefaultsCommand}"/>
            </DockPanel>
        </Border>

        <!-- Main 2-Column Mapping Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Visual Remote & Button Selector -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实体遥控器按键" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <!-- Visual Remote Control Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,18" Width="210">
                                <StackPanel>
                                    <!-- Top Row: Power & Voice -->
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#332B2B" Foreground="#FF8888" BorderBrush="#553333"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#223344" Foreground="#88CCFF" BorderBrush="#335577"
                                                ToolTip="语音键由【输入法集成】配置全局生效"/>
                                    </Grid>

                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="75" Width="150" Height="150" Margin="0,0,0,18">
                                        <Grid>
                                            <!-- Up -->
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="42" Height="36" Margin="0,6,0,0"/>
                                            <!-- Down -->
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="42" Height="36" Margin="0,0,0,6"/>
                                            <!-- Left -->
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="36" Height="42" Margin="6,0,0,0"/>
                                            <!-- Right -->
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="42" Margin="0,0,6,0"/>
                                            <!-- OK / Center -->
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="52" Height="52"
                                                    FontWeight="Bold" Background="#383A40"/>
                                        </Grid>
                                    </Border>

                                    <!-- Navigation Keys Grid -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                            <RowDefinition Height="38"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Back & Volume Up -->
                                        <Button Grid.Row="0" Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Margin="3"/>

                                        <!-- Row 1: Home & Volume Down -->
                                        <Button Grid.Row="1" Grid.Column="0" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Margin="3"/>

                                        <!-- Row 2: Menu & Live TV -->
                                        <Button Grid.Row="2" Grid.Column="0" Content="≡ 菜单" Tag="Menu" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="📺 电视 / TV" Tag="LiveTv" Click="SelectRemoteButton" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Button Quick Picker Dropdown -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="按键快速选择：" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CurrentMappings}" SelectedItem="{Binding SelectedMapping}" DisplayMemberPath="ButtonName"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Column: Mapping Inspector / Editor -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="24"
                    DataContext="{Binding SelectedMapping}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Inspector Header -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,20">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ButtonName, TargetNullValue='请选择按键'}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <Border Background="#007ACC" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="正在配置" FontSize="11" Foreground="#FFF"/>
                                </Border>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="清除按键设置" Padding="12,6" Background="Transparent" BorderBrush="{StaticResource BorderColorBrush}" Foreground="{StaticResource SecondaryTextBrush}"
                                    Command="{Binding DataContext.ClearSelectedMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DockPanel>

                        <!-- Single Click Section -->
                        <Border Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="单击动作 (Single Click)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="按一下立即触发的动作类型：" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableActions}" SelectedItem="{Binding ClickAction, Mode=TwoWay}" Margin="0,0,0,14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Keyboard Shortcut Input -->
                                <StackPanel Visibility="{Binding TextOrShortcutVisibility}">
                                    <TextBlock Text="目标键盘快捷键：" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ParameterText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Background="#1E1E1E" Foreground="#FFF" Padding="10,7" Margin="0,0,0,6"/>
                                    <TextBlock Text="提示: 支持组合键，如 'Ctrl+Alt+A'、'Enter'、'Escape'、'Up'、'Alt+Tab'、'Win+D' 等。"
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <!-- Media Command Dropdown -->
                                <StackPanel Visibility="{Binding MediaVisibility}">
                                    <TextBlock Text="系统多媒体控制：" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableMediaCommands}" SelectedItem="{Binding ClickMedia, Mode=TwoWay}" Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Long Press Section -->
                        <Border Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="长按动作 (Long Press)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="按住遥控器按键不放时的行为方式：" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableLongPressActions}" SelectedItem="{Binding LongPressAction, Mode=TwoWay}" Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="选择【持续连发】时，按住约 0.4 秒后开始以 100ms 间隔连发单击动作，松开即停。"
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Save & Confirm Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 保存当前设置" Padding="20,10" Background="#007ACC"
                                    Command="{Binding DataContext.SaveMappingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
