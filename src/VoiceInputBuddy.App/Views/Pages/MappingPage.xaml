<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:VoiceInputBuddy.Core.Models;assembly=VoiceInputBuddy.Core"
             xmlns:vm="clr-namespace:VoiceInputBuddy.App.ViewModels">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="按键映射" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="选择遥控器和实体按键，设置单击与长按动作" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="遥控器" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="170"/>
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DeviceNote}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="14">
                <DockPanel><TextBlock DockPanel.Dock="Top" Text="遥控器按键" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding CurrentMappings}" SelectedItem="{Binding SelectedMapping}" DisplayMemberPath="ButtonName" Background="Transparent" Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedDevice.ModelType}" Value="{x:Static model:RemoteModelType.XiaomiRC003}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
                        </ListBox>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedDevice.ModelType}" Value="{x:Static model:RemoteModelType.XiaomiRC003}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                            <Border Background="#35373B" CornerRadius="24" Padding="14" Margin="8,0,8,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="电源" Tag="Power" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="语音" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="语音键在输入法集成中设置"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="↑" Tag="Up" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="2" Grid.Column="0" Content="←" Tag="Left" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="2" Grid.Column="1" Content="确定" Tag="Ok" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="→" Tag="Right" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="3" Grid.Column="1" Content="↓" Tag="Down" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="4" Grid.Column="0" Content="返回" Tag="Back" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="5" Grid.Column="0" Content="主页" Tag="Home" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="5" Grid.Column="2" Content="音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="6" Grid.Column="0" Content="菜单" Tag="Menu" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="TV" Tag="LiveTv" Click="SelectRemoteButton" Margin="2" Padding="2"/>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="20" DataContext="{Binding SelectedMapping}">
                <StackPanel>
                    <TextBlock Text="{Binding ButtonName, TargetNullValue='请选择按键'}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,18"/>
                    <TextBlock Text="单击动作" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableActions}" SelectedItem="{Binding ClickAction, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
                    <StackPanel Visibility="{Binding TextOrShortcutVisibility}"><TextBlock Text="快捷键 / 文本" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ParameterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" Padding="8,6" Margin="0,0,0,16"/></StackPanel>
                    <StackPanel Visibility="{Binding MediaVisibility}"><TextBlock Text="媒体操作" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableMediaCommands}" SelectedItem="{Binding ClickMedia, Mode=TwoWay}" Margin="0,0,0,16"/></StackPanel>
                    <TextBlock Text="长按动作" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingItemViewModel.AvailableLongPressActions}" SelectedItem="{Binding LongPressAction, Mode=TwoWay}" Margin="0,0,0,20"/>
                    <Button Content="保存配置" Background="#007ACC" HorizontalAlignment="Left" Padding="18,8" Command="{Binding DataContext.SaveMappingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
