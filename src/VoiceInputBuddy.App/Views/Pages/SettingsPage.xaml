<UserControl x:Class="VoiceInputBuddy.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="通用设置" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="应用程序常规偏好设置、向导与运行诊断" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Card 1: Rerun Wizard -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="500">
                        <TextBlock Text="配置与验收向导" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="重新运行全流程音频驱动检测、蓝牙设备连接与按键转写验收向导。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="🚀 重新运行向导" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="16,9" Background="#007ACC"
                            Command="{Binding RerunWizardCommand}"/>
                </DockPanel>
            </Border>

            <!-- Card 2: Startup & Tray Preferences -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="常规偏好" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>
                    <CheckBox Content="开机时自动在后台启动 Voice Input Buddy" IsChecked="{Binding LaunchAtStartup}" Foreground="#FFF" Margin="0,0,0,14"/>
                    <CheckBox Content="关闭主窗口时最小化至系统通知区域 (托盘)" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" Foreground="#FFF"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Diagnostic Logs -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="500">
                        <TextBlock Text="诊断日志与故障排查" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="在本地记录蓝牙通信、ATVV 语音协商、按键映射分发等技术排查日志。严禁且不记录任何语音音频或转写文本。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding LogDirectoryPath, StringFormat='存储路径: {0}'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="📁 打开日志文件夹" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,8"
                            Command="{Binding OpenLogFolderCommand}"/>
                </DockPanel>
            </Border>

            <!-- Card 4: About -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="关于 Voice Input Buddy (Windows)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="让闲置的蓝牙电视遥控器化身桌面语音输入神器" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='当前版本: {0}'}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="本项目遵循 GPL-3.0-only 开源协议发布。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
